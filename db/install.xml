<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/aigradedassign/db" VERSION="2026090100" COMMENT="XMLDB file for mod_aigradedassign"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="aigradedassign" COMMENT="AI graded assignment activity instances">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT=""/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="rubrictext" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="exampletext" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="examplefeedback" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="exampletext2" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="examplefeedback2" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="exampletext3" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="examplefeedback3" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="provider" TYPE="char" LENGTH="30" NOTNULL="true" DEFAULT="default"/>
        <FIELD NAME="requirevalidation" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="completionevaluated" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="aigradedassign_submissions" COMMENT="Latest plain-text submission per student and activity">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="aigradedassignid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="submissiontext" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="submitted"/>
        <FIELD NAME="attemptnumber" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timeevaluated" TYPE="int" LENGTH="10" NOTNULL="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="activity" TYPE="foreign" FIELDS="aigradedassignid" REFTABLE="aigradedassign" REFFIELDS="id"/>
        <KEY NAME="user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="activityuser" UNIQUE="true" FIELDS="aigradedassignid,userid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="aigradedassign_evaluations" COMMENT="Evaluation generated for the latest submission attempt">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="submissionid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="attemptnumber" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="provider" TYPE="char" LENGTH="30" NOTNULL="true" DEFAULT="mock"/>
        <FIELD NAME="model" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT="mock-v1"/>
        <FIELD NAME="score" TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="false"/>
        <FIELD NAME="feedbacktext" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="reviewstatus" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="approved"/>
        <FIELD NAME="reviewedby" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="timereviewed" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="submission" TYPE="foreign" FIELDS="submissionid" REFTABLE="aigradedassign_submissions" REFFIELDS="id"/>
        <KEY NAME="reviewer" TYPE="foreign" FIELDS="reviewedby" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="submissionattempt" UNIQUE="true" FIELDS="submissionid,attemptnumber"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
